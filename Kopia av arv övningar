      "source": [
        "### Exempel 4 — `super().__init__()`\n",
        "\n",
        "Om subklassen behöver egna attribut UTÖVER de ärvda, kan man använda `super().__init__(...)` för att köra superklassens konstruktor, och sedan lägga till sina egna rader."
      ],
      "id": "ehhUPg1jgja5"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "2HYND5Q0gja5"
      },
      "outputs": [],
      "source": [
        "class Djur:\n",
        "    def __init__(self, namn):\n",
        "        self.namn = namn\n",
        "\n",
        "class Hund(Djur):\n",
        "    def __init__(self, namn, ras):\n",
        "        super().__init__(namn)   # kör Djurs __init__\n",
        "        self.ras = ras            # eget, nytt attribut\n",
        "\n",
        "nero = Hund(\"Nero\", \"Labrador\")\n",
        "print(nero.namn, nero.ras)\n"
      ],
      "id": "2HYND5Q0gja5"
    },
