      "outputs": [],
      "source": [
        "class Djur:\n",
        "    def __init__(self, namn):\n",
        "        self.namn = namn\n",
        "\n",
        "class Hund(Djur):\n",
        "    def __init__(self, namn, ras):\n",
        "        super().__init__(namn)\n",
        "        self.ras = ras\n",
        "\n",
        "    def hamta_boll(self):\n",
        "        print(self.namn + \" hämtar bollen!\")\n",
        "\n",
        "nero = Hund(\"Nero\", \"Labrador\")\n",
        "nero.hamta_boll()\n"
