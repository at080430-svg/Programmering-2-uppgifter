      "source": [
        "class Djur:\n",
        "    def __init__(self, namn):\n",
        "        self.namn = namn\n",
        "\n",
        "    def beskrivning(self):\n",
        "        print(self.namn + \" är ett djur.\")\n",
        "\n",
        "class Hund(Djur):\n",
        "    def beskrivning(self):\n",
