        "\n",
        "    def ljud(self):\n",
        "        print(self.namn + \" gör ett ljud.\")\n",
        "\n",
        "class Hund(Djur):\n",
        "    def ljud(self):              # skriver över Djurs ljud()\n",
        "        print(self.namn + \" säger: Voff!\")\n",
        "\n",
        "nero = Hund(\"Nero\")\n",
        "nero.ljud()   # Nero säger: Voff!\n"
